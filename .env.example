# --- Mailgun (conta principal, todos os dominios de clientes) ---
# Private API key: https://app.mailgun.com/settings/api_security
MAILGUN_API_KEY=
# Deixe em branco para US (https://api.mailgun.net).
# Use https://api.eu.mailgun.net se a conta for da regiao EU.
MAILGUN_BASE_URL=

# --- snov-am-api (contas Snov.io ativas + list_ids) ---
# URL interna em producao (rede docker "ativaai"): http://snov-am-api:8000
CREDENTIALS_API_URL=
# API key gerada em POST /api/api-keys no snov-am-api,
# com scopes accounts:read e credentials:read.
CREDENTIALS_API_KEY=

# Quantos e-mails por requisicao ao enviar para a Lista de e-mails a nao
# enviar do Snov.io (maximo permitido pela Snov.io: 100).
SNOVIO_BATCH_SIZE=100
# Limite de requisicoes/minuto a API do Snov.io.
SNOVIO_RATE_LIMIT_PER_MIN=60

# Quantos dominios (pares dominio Mailgun <-> conta Snov.io) processar em
# paralelo.
PIPELINE_WORKERS=5

# Porta do host publicada pro painel (mude se 8080 ja estiver ocupada).
DASHBOARD_PORT=8080

# --- Painel (SQLite) ---
# Onde gravar o historico de execucoes lido pelo painel (app.py). O script
# (negativacao_mailgun.py) e o painel precisam apontar pro MESMO arquivo -
# no docker-compose.yml isso ja e garantido pelo volume compartilhado.
DB_PATH=./data/negativacao.db

# --- SendGrid (negativacao_sendgrid.py, roda neste mesmo stack via
# "docker compose --profile manual run --rm negativacao_sendgrid") ---
# Le contatos com ativo=0 do MySQL do webhook-api de supressoes SendGrid,
# e usa as MESMAS contas Snov.io (CREDENTIALS_API_URL/KEY acima) que o
# negativacao_mailgun.py.
SENDGRID_DB_HOST=
SENDGRID_DB_PORT=3306
SENDGRID_DB_USER=
SENDGRID_DB_PASSWORD=
SENDGRID_DB_NAME=
SENDGRID_DB_TABLE=
# So mude se as colunas da tabela tiverem nomes diferentes destes.
SENDGRID_DB_EMAIL_COLUMN=email
SENDGRID_DB_ATIVO_COLUMN=ativo
SENDGRID_DB_DATE_COLUMN=data_alteracao

# So usada se algum caller externo (fora deste stack) ainda entregar runs
# via POST /api/sendgrid/ingest - o negativacao_sendgrid.py acima grava
# direto no SQLite do painel, nao usa isso. Deixe em branco se nao houver
# esse caller.
SENDGRID_INGEST_API_KEY=

# --- Postal (negativacao_postal.py) ---
# Postal nao tem API de pull para bounces/falhas - o dado so chega via
# webhook, que o proprio Postal envia pra URL configurada no admin de cada
# servidor. Gere uma chave aleatoria aqui e configure o webhook do Postal
# apontando para:
#   https://<seu-host>/api/postal/webhook?key=SEU_VALOR_AQUI
# Eventos a assinar no admin do Postal: pelo menos MessageDeliveryFailed,
# MessageHeld e MessageBounced (os demais sao recebidos e ignorados).
POSTAL_WEBHOOK_SECRET=
